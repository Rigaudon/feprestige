# Sanity — copy this file to .env.local and fill in the values.
# projectId + dataset are public (safe to expose in the browser).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# API version — a fixed date pins query behavior. Bump intentionally.
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Shared secret for the /api/revalidate webhook. Generate a random string and
# use the SAME value in the Sanity webhook config (manage.sanity.io).
SANITY_REVALIDATE_SECRET=

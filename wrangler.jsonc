{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feprestige",
  // Custom entrypoint that wraps the OpenNext-generated worker and adds a
  // `scheduled` handler (see custom-worker.ts). It imports .open-next/worker.js,
  // so the OpenNext build must still run first (it does — `opennextjs-cloudflare
  // build` in the deploy script generates .open-next/ before wrangler bundles).
  "main": "custom-worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "feprestige"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Persistent incremental-cache store for OpenNext (see open-next.config.ts).
  // Prerendered ISR/SSG pages live here so they're served from cache instead of
  // re-rendered (re-fetching WOM) on every request. Create once with:
  //   npx wrangler r2 bucket create feprestige-cache
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "feprestige-cache" },
    // Re-hosted "drop of the week" images + manifest.json (see src/discord/).
    // Public read is served from the bucket's r2.dev URL (later a custom
    // subdomain). Create once with:
    //   npx wrangler r2 bucket create feprestige-drops
    { "binding": "DROPS_BUCKET", "bucket_name": "feprestige-drops" }
  ],
  // Tag cache for on-demand revalidation. revalidateTag() (the /api/revalidate
  // webhook) records invalidations here; without it, tag revalidation is a no-op
  // on Cloudflare and publishes only surface via the 1h time-based revalidate.
  // Binding name is fixed by the OpenNext d1-next-tag-cache override. Create once:
  //   npx wrangler d1 create feprestige-tags
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "feprestige-tags",
      "database_id": "b97e035a-e593-4c00-a16c-002b03f6d425"
    }
  ],
  // Attaches the custom domain on deploy. Requires the zone (feprestige.com) to
  // live in the same Cloudflare account — it does, since the domain is registered
  // there. Cloudflare provisions the DNS record + TLS cert automatically.
  "routes": [{ "pattern": "feprestige.com", "custom_domain": true }],
  // Cron Trigger for the Discord "drops" incremental sync — the reliable primary
  // schedule (GitHub Actions cron is best-effort and was leaving runs queued for
  // hours). Fires custom-worker.ts's `scheduled` handler every 15 min, which calls
  // the secret-gated /api/discord/sync route in-process. Requires the runtime
  // secret DISCORD_SYNC_SECRET on the worker.
  "triggers": { "crons": ["*/15 * * * *"] }
}

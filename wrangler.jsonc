{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feprestige",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "feprestige"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  // Attaches the custom domain on deploy. Requires the zone (feprestige.com) to
  // live in the same Cloudflare account — it does, since the domain is registered
  // there. Cloudflare provisions the DNS record + TLS cert automatically.
  "routes": [{ "pattern": "feprestige.com", "custom_domain": true }]
}

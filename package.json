{
  "name": "feprestige",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3333",
    "build": "next build",
    "start": "next start -p 3333",
    "lint": "eslint",
    "clean:cache": "node -e \"require('fs').rmSync('.next/cache',{recursive:true,force:true})\"",
    "prepreview": "npm run clean:cache",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "predeploy": "npm run clean:cache",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preupload": "npm run clean:cache",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typegen": "sanity typegen generate"
  },
  "dependencies": {
    "@portabletext/react": "^7.0.1",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "^6.8.0",
    "next": "16.2.12",
    "next-sanity": "^13.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^6.8.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.118.0"
  }
}
